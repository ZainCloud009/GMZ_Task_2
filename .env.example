# ==========================================
# GMZ Cloud Application Environment Variables Template
# ==========================================

# Application Port
PORT=3000

# AWS RDS PostgreSQL Database Configuration
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_USER=postgresadmin
DB_PASSWORD=your-secure-password
DB_NAME=gmz_tasks_db

# Database Web Management Service URL (Adminer / phpMyAdmin proxy)
ADMINER_SERVICE_URL=http://gmz-adminer-service:8080
